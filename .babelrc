{
  "presets": [
    [
      "env",
      {
        "modules": false,

        "targets": {
          "browsers": ["> 1%", "last 2 versions", "not ie <= 8"]
        },
        "useBuiltIns": "entry",
        "corejs": 2
      }
    ]
  ],
  "plugins": [
    "transform-runtime",
    "transform-es2015-block-scoping",
    "syntax-dynamic-import"
  ]
}
